---
layout: base.njk
---
<article class="page-simple">
  <header class="tete-page">
    <div class="tete-int">
      {%- if surtitre %}<p class="surtitre">{{ surtitre }}</p>{% endif %}
      <h1>{{ title }}</h1>
      {%- if chapo %}<p class="chapo">{{ chapo }}</p>{% endif %}
    </div>
  </header>
  <div class="texte">
    {{ content | safe }}
  </div>
</article>
